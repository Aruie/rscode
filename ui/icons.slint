export component Icon inherits Path {
    in property <string> d;
    in property <brush> color: #cccccc;
    in property <length> size: 16px;
    in property <length> stroke-w: 1.2px;
    width: self.size;
    height: self.size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: self.d;
    stroke: self.color;
    stroke-width: self.stroke-w;
    fill: transparent;
}

// The VS Code-like app logo (blue folded ribbon).
export component AppLogo inherits Rectangle {
    width: 16px;
    height: 16px;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M17 2 L22 4.5 V19.5 L17 22 L7 13 L3 16 L1.5 15 V9 L3 8 L7 11 Z M17 7 L11.5 12 L17 17 Z";
        fill: #2489ca;
        stroke: transparent;
    }
}
