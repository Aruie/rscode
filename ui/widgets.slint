import { T } from "theme.slint";
import { Icons, Icon } from "icons.slint";

export struct TreeRow {
    name: string,
    depth: int,
    is-dir: bool,
    expanded: bool,
    glyph: string,
    glyph-color: color,
    selected: bool,
    loading: bool,
}

export struct SearchRow {
    is-file: bool,
    expanded: bool,
    name: string,
    dir: string,
    count: int,
    before: string,
    hit: string,
    after: string,
    glyph: string,
    glyph-color: color,
}

export struct HlSpan {
    text: string,
    color: color,
}

export struct HlLine {
    line: int,
    spans: [HlSpan],
}

export struct ExtRow {
    kind: int, // 0 extension, 1 language grammar
    name: string,
    detail: string,
    description: string,
    enabled: bool,
    error: string,
}

// One prebuilt widget filled by an extension. kind: 0 heading, 1 paragraph, 2 list item,
// 3 code, 4 rule, 5 table row, 6 button, 7 label
export struct ExtBlock {
    kind: int,
    text: styled-text,
    plain: string,
    level: int,
    marker: string,
    cells: [styled-text],
    header: bool,
    id: string,
    quote: int,
    indent: int,
    code: [HlLine],
}

export struct TabItem {
    title: string,
    desc: string,
    dirty: bool,
    active: bool,
    glyph: string,
    glyph-color: color,
}

export struct QuickItem {
    label: string,
    desc: string,
    detail: string,
    glyph: string,
    glyph-color: color,
    keybinding: string,
    selectable: bool,
}

export struct MenuItemData {
    label: string,
    keybinding: string,
    separator: bool,
    enabled: bool,
}

export struct HostRow {
    name: string,
    detail: string,
    connected: bool,
}

export struct Crumb {
    label: string,
    glyph: string,
    glyph-color: color,
}

export struct Toast {
    message: string,
    kind: int, // 0 info, 1 warning, 2 error, 3 progress
}

// Small square icon button used in toolbars (explorer header, find widget, tabs).
export component ToolButton inherits Rectangle {
    in property <string> icon;
    in property <length> icon-size: 16px;
    in property <bool> toggled: false;
    in property <bool> enabled: true;
    in property <brush> icon-color: T.fg;
    callback clicked();
    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: !root.enabled ? transparent : root.toggled ? #2489db51 : ta.has-hover ? T.toolbar-hover : transparent;
    border-width: root.toggled ? 1px : 0px;
    border-color: T.focus-border;
    Icon {
        d: root.icon;
        size: root.icon-size;
        color: root.enabled ? root.icon-color : #ffffff40;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

export component ActivityItem inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    callback clicked();
    width: 48px;
    height: 48px;
    Rectangle {
        x: 0;
        width: 2px;
        background: root.active ? T.fg-bright : transparent;
    }

    Icon {
        d: root.icon;
        size: 24px;
        stroke-w: 1.5px;
        color: root.active || ta.has-hover ? T.fg-bright : T.fg-muted;
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component TreeRowView inherits Rectangle {
    in property <TreeRow> data;
    in property <bool> focused;
    callback clicked();
    callback context(length, length);
    height: 22px;
    background: root.data.selected ? (root.focused ? T.list-active : T.list-inactive) : ta.has-hover ? T.hover : transparent;
    border-width: root.data.selected && root.focused ? 1px : 0px;
    border-color: T.focus-border;
    HorizontalLayout {
        padding-left: 4px + root.data.depth * 8px;
        padding-right: 8px;
        Rectangle {
            width: 20px;
            if root.data.is-dir: Icon {
                d: root.data.expanded ? Icons.chevron-down : Icons.chevron-right;
                size: 16px;
                color: T.fg;
            }
        }

        if !root.data.is-dir: Rectangle {
            width: 22px;
            Text {
                x: 0;
                text: root.data.glyph;
                color: root.data.glyph-color;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.data.loading ? root.data.name + "  …" : root.data.name;
            color: T.fg;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            root.clicked();
        }
    }
}

export component EditorTab inherits Rectangle {
    in property <TabItem> tab;
    callback clicked();
    callback close();
    height: 35px;
    width: hl.preferred-width;
    background: root.tab.active ? T.bg-editor : T.bg-side;
    // top accent / bottom border
    Rectangle {
        y: 0;
        height: 1px;
        background: root.tab.active ? T.accent : transparent;
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: root.tab.active ? transparent : T.border;
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: T.border;
    }

    ta := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.middle {
                root.close();
            }
        }
        clicked => {
            root.clicked();
        }
    }

    hl := HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        alignment: start;
        Text {
            text: root.tab.glyph;
            color: root.tab.glyph-color;
            font-size: 10px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Text {
            text: root.tab.title;
            color: root.tab.active ? T.fg-bright : T.fg-dim;
            vertical-alignment: center;
        }

        if root.tab.desc != "": Text {
            text: root.tab.desc;
            color: T.fg-muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        Rectangle {
            width: 20px;
            close := Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 4px;
                background: cta.has-hover ? T.toolbar-hover : transparent;
                if root.tab.dirty && !cta.has-hover: Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.tab.active ? T.fg-bright : T.fg-dim;
                }
                if (!root.tab.dirty || cta.has-hover) && (root.tab.active || ta.has-hover || cta.has-hover): Icon {
                    d: Icons.close;
                    size: 16px;
                    color: root.tab.active ? T.fg-bright : T.fg-dim;
                }
                cta := TouchArea {
                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }
}

export component StatusItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <brush> fg: T.fg;
    in property <brush> bg: transparent;
    in property <brush> hover-bg: T.toolbar-hover;
    callback clicked();
    height: 22px;
    horizontal-stretch: 0;
    background: ta.has-hover ? root.hover-bg : root.bg;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        if root.icon != "": Icon {
            y: (22px - 14px) / 2;
            d: root.icon;
            size: 14px;
            color: root.fg;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component MenuTitle inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    callback pressed();
    callback hovered();
    height: 26px;
    width: txt.preferred-width + 16px;
    border-radius: 5px;
    background: root.open || ta.has-hover ? T.toolbar-hover : transparent;
    txt := Text {
        text: root.label;
        color: T.fg;
        vertical-alignment: center;
    }

    ta := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.pressed();
            }
        }
        changed has-hover => {
            if self.has-hover {
                root.hovered();
            }
        }
    }
}

export component WinButton inherits Rectangle {
    in property <string> icon;
    in property <bool> danger;
    callback clicked();
    width: 46px;
    background: ta.has-hover ? (root.danger ? T.close-red : T.toolbar-hover) : transparent;
    Icon {
        d: root.icon;
        size: 16px;
        stroke-w: 1px;
        color: ta.has-hover && root.danger ? #ffffff : T.fg;
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component BlueButton inherits Rectangle {
    in property <string> text;
    in property <bool> secondary;
    callback clicked();
    height: 26px;
    border-radius: 2px;
    background: root.secondary ? (ta.has-hover ? #3c3c3c : #313131) : (ta.has-hover ? T.accent-hover : T.accent);
    border-width: root.secondary ? 1px : 0px;
    border-color: #ffffff12;
    min-width: txt.preferred-width + 26px;
    txt := Text {
        text: root.text;
        color: #ffffff;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component KeyCap inherits Rectangle {
    in property <string> text;
    height: 18px;
    width: t.preferred-width + 10px;
    border-radius: 3px;
    background: #8080802b;
    border-width: 1px;
    border-color: #33333399;
    t := Text {
        text: root.text;
        color: T.fg-dim;
        font-size: 11px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export component CheckBox inherits Rectangle {
    in property <bool> checked;
    callback toggled();
    width: 18px;
    height: 18px;
    border-radius: 3px;
    background: root.checked ? T.accent : T.input-bg;
    border-width: 1px;
    border-color: root.checked ? T.accent : ta.has-hover ? T.focus-border : T.input-border;
    if root.checked: Icon {
        d: "M5 12.5 L10 17 L19 7";
        size: 16px;
        stroke-w: 2px;
        color: #ffffff;
    }
    ta := TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

// Renders one ExtBlock. Markdown preview look follows VS Code's preview styles.
export component ExtBlockView inherits VerticalLayout {
    in property <ExtBlock> b;
    in property <length> base: 14px;
    callback link(string);
    callback button(string);
    private property <length> pad-left: root.b.indent * 22px + root.b.quote * 18px;
    padding-top: root.b.kind == 0 ? (root.b.level <= 2 ? 18px : 12px) : root.b.kind == 5 ? 0px : 6px;
    padding-bottom: root.b.kind == 0 && root.b.level <= 2 ? 6px : root.b.kind == 5 ? 0px : 6px;

    HorizontalLayout {
        spacing: 0;
        // quote bars
        for q in root.b.quote: Rectangle {
            width: 18px;
            Rectangle {
                x: 0;
                width: 4px;
                background: #ffffff33;
            }
        }
        Rectangle {
            width: root.b.indent * 22px;
        }

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            if root.b.kind == 0: StyledText {
                text: root.b.text;
                default-color: T.fg-bright;
                default-font-size: root.b.level == 1 ? root.base * 2 : root.b.level == 2 ? root.base * 1.5 : root.b.level == 3 ? root.base * 1.25 : root.base;
                link-color: #4daafc;
                link-clicked(u) => {
                    root.link(u);
                }
            }
            if root.b.kind == 0 && root.b.level <= 2: Rectangle {
                height: 1px;
                background: #ffffff2e;
            }
            if root.b.kind == 1: StyledText {
                text: root.b.text;
                default-color: T.fg;
                default-font-size: root.base;
                link-color: #4daafc;
                link-clicked(u) => {
                    root.link(u);
                }
            }
            if root.b.kind == 2: HorizontalLayout {
                spacing: 6px;
                Text {
                    width: 22px;
                    text: root.b.marker;
                    color: T.fg;
                    font-size: root.base;
                    horizontal-alignment: right;
                }

                StyledText {
                    horizontal-stretch: 1;
                    text: root.b.text;
                    default-color: T.fg;
                    default-font-size: root.base;
                    link-color: #4daafc;
                    link-clicked(u) => {
                        root.link(u);
                    }
                }
            }
            if root.b.kind == 3: Rectangle {
                background: #ffffff12;
                border-radius: 3px;
                clip: true;
                VerticalLayout {
                    padding: 12px;
                    spacing: 0;
                    for l in root.b.code: HorizontalLayout {
                        spacing: 0;
                        alignment: start;
                        for sp in l.spans: Text {
                            text: sp.text;
                            color: sp.color;
                            font-family: T.mono-font;
                            font-size: root.base - 1px;
                            wrap: no-wrap;
                        }
                        // keep empty lines one line tall
                        if l.spans.length == 0: Text {
                            text: " ";
                            font-family: T.mono-font;
                            font-size: root.base - 1px;
                        }
                    }
                }
            }
            if root.b.kind == 4: Rectangle {
                height: 2px;
                background: #ffffff2e;
            }
            if root.b.kind == 5: HorizontalLayout {
                spacing: 0;
                for c in root.b.cells: Rectangle {
                    horizontal-stretch: 1;
                    background: root.b.header ? #ffffff0d : transparent;
                    border-width: 1px;
                    border-color: #ffffff2e;
                    VerticalLayout {
                        padding: 6px;
                        padding-left: 10px;
                        StyledText {
                            text: c;
                            default-color: T.fg;
                            default-font-size: root.base;
                            link-color: #4daafc;
                            link-clicked(u) => {
                                root.link(u);
                            }
                        }
                    }
                }
            }
            if root.b.kind == 6: HorizontalLayout {
                alignment: start;
                BlueButton {
                    text: root.b.plain;
                    clicked => {
                        root.button(root.b.id);
                    }
                }
            }
            if root.b.kind == 7: Text {
                text: root.b.plain;
                color: T.fg;
                font-size: root.base;
                wrap: word-wrap;
            }
        }
    }
}
