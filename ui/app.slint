import { ListView, ScrollView } from "std-widgets.slint";
import { EditorGroup, GroupData } from "editor_group.slint";
import { T } from "theme.slint";
import { Icons, Icon, AppLogo } from "icons.slint";
import {
    TreeRow, TabItem, QuickItem, MenuItemData, HostRow, Crumb, Toast, HlSpan, HlLine, SearchRow, ExtRow, ExtBlock, CheckBox, ExtBlockView,
    ToolButton, ActivityItem, TreeRowView, EditorTab, StatusItem, MenuTitle, WinButton, BlueButton, KeyCap
} from "widgets.slint";

export { TreeRow, TabItem, QuickItem, MenuItemData, HostRow, Crumb, Toast, HlSpan, HlLine, SearchRow, ExtRow, ExtBlock, GroupData }

export component App inherits Window {
    // ---------- window ----------
    in property <string> window-title: "rcode";
    title: root.window-title;
    no-frame: true;
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 640px;
    min-height: 400px;
    background: T.bg-side;
    default-font-family: T.ui-font;
    default-font-size: 13px;

    // ---------- title bar ----------
    in property <string> command-center-text: "rcode";
    in property <[string]> menu-titles: ["File", "Edit", "Selection", "View", "Go", "Run", "Terminal", "Help"];
    in property <int> menu-index: -1;
    callback menu-open(int, length);
    callback win-minimize();
    callback win-toggle-maximize();
    callback win-close();
    callback command-center-clicked();

    // ---------- activity bar / sidebar ----------
    in property <bool> sidebar-visible: true;
    in property <string> active-view: "explorer";
    in-out property <length> sidebar-width: 260px;
    callback activity(string);

    // explorer
    in property <string> workspace-name;
    in property <[TreeRow]> tree-rows;
    callback tree-clicked(int);
    callback tree-context(int, length, length);
    callback tree-key(string, bool, bool, bool) -> bool;
    callback explorer-action(string);
    out property <bool> tree-focused: tree-fs.has-focus;

    // remote explorer
    in property <[HostRow]> hosts;
    callback host-clicked(int);
    callback remote-action(string);

    // search view
    in property <[SearchRow]> search-rows;
    in-out property <string> search-text;
    in property <string> search-message;
    in property <bool> search-running;
    in property <bool> search-case;
    in property <bool> search-word;
    in property <bool> search-regex;
    in property <int> search-focus-req;
    callback search-edited(string);
    callback search-toggle(string);
    callback search-row-clicked(int);
    callback search-action(string);
    callback search-submit();

    // extensions view and extension panel (beside the editor)
    in property <[ExtRow]> ext-rows;
    in property <string> ext-dir;
    callback ext-toggle(int);

    // CPU / memory of this process (title bar)
    in property <string> stats-label: "CPU 0.0%  ·  0 MB";
    in-out property <bool> stats-open;
    in property <string> stats-cpu-path;
    in property <string> stats-mem-path;
    in property <string> stats-cpu-max;
    in property <string> stats-mem-max;
    callback stats-clicked();

    // ---------- editor groups ----------
    in property <GroupData> group0;
    in property <GroupData> group1;
    in property <bool> split;
    in-out property <float> split-ratio: 0.5;
    in property <bool> editor-visible: false;
    in-out property <length> editor-font-size: 14px;
    out property <length> line-h: g0.line-h;
    callback group-activated(int);
    callback tab-clicked(int, int);
    callback tab-close(int, int);
    callback title-button-clicked(int);
    callback editor-edited(int, string);
    callback editor-key(int, string, bool, bool, bool) -> bool;
    callback editor-cursor-moved(int, int, int);
    callback gutter-clicked(int, int, bool);
    callback editor-viewport(int, int, int);
    callback panel-link(int, string);
    callback panel-button(int, string);
    callback command(string);
    // window edge resize: 0 N, 1 NE, 2 E, 3 SE, 4 S, 5 SW, 6 W, 7 NW
    callback start-resize(int);

    // find widget
    in property <bool> find-open;
    in property <bool> replace-open;
    in-out property <string> find-text;
    in-out property <string> replace-text;
    in property <string> find-info;
    in property <bool> find-case;
    in property <bool> find-word;
    callback find-edited(string);
    callback find-next(bool);
    callback replace-one();
    callback replace-all();
    callback find-close();
    callback find-toggle-replace();
    callback find-toggle(string);

    // ---------- status bar ----------
    in property <string> status-remote;
    in property <bool> status-remote-busy;
    in property <string> status-message;
    in property <string> status-lncol: "Ln 1, Col 1";
    in property <string> status-indent: "Spaces: 4";
    in property <string> status-encoding: "UTF-8";
    in property <string> status-eol: "LF";
    in property <string> status-lang: "Plain Text";
    callback status-clicked(string);

    // ---------- quick input (Ctrl+P / Ctrl+Shift+P / prompts) ----------
    in property <bool> quick-open;
    in-out property <string> quick-text;
    in property <string> quick-placeholder;
    in property <string> quick-title;
    in property <bool> quick-password;
    in property <bool> quick-ok;
    in property <[QuickItem]> quick-items;
    in-out property <int> quick-index;
    in property <int> quick-cursor-pos;
    in property <int> quick-reset-cursor;
    callback quick-edited(string);
    callback quick-accept(int);
    callback quick-cancel();

    // ---------- popup menu (menubar dropdowns / context menus) ----------
    in property <bool> popup-open;
    in property <bool> popup-from-menubar;
    in property <length> popup-x;
    in property <length> popup-y;
    in property <[MenuItemData]> popup-items;
    callback popup-activated(int);
    callback popup-dismiss();

    // ---------- modal dialog ----------
    in property <bool> dialog-open;
    in property <string> dialog-message;
    in property <string> dialog-detail;
    in property <[string]> dialog-buttons;
    callback dialog-result(int);

    // ---------- notifications ----------
    in property <[Toast]> toasts;
    callback toast-close(int);

    // ---------- global keys ----------
    callback global-key(string, bool, bool, bool) -> bool;

    // ---------- functions callable from Rust ----------
    public function set-text(g: int, t: string) {
        if g == 0 {
            g0.set-text(t);
        } else {
            g1.set-text(t);
        }
    }
    public function set-selection(g: int, anchor: int, focus: int) {
        if g == 0 {
            g0.set-selection(anchor, focus);
        } else {
            g1.set-selection(anchor, focus);
        }
    }
    public function focus-editor(g: int) {
        if g == 0 {
            g0.focus-editor();
        } else {
            g1.focus-editor();
        }
    }
    public function editor-copy(g: int) {
        if g == 0 {
            g0.copy();
        } else {
            g1.copy();
        }
    }
    public function editor-cut(g: int) {
        if g == 0 {
            g0.cut();
        } else {
            g1.cut();
        }
    }
    public function editor-paste(g: int) {
        if g == 0 {
            g0.paste();
        } else {
            g1.paste();
        }
    }
    public function focus-find(g: int) {
        if g == 0 {
            g0.focus-find();
        } else {
            g1.focus-find();
        }
    }
    public function focus-replace(g: int) {
        if g == 0 {
            g0.focus-replace();
        } else {
            g1.focus-replace();
        }
    }
    public pure function editor-cursor(g: int) -> int {
        return g == 0 ? g0.cursor : g1.cursor;
    }
    public pure function editor-anchor(g: int) -> int {
        return g == 0 ? g0.anchor : g1.anchor;
    }
    public pure function editor-text(g: int) -> string {
        return g == 0 ? g0.text : g1.text;
    }
    public pure function editor-scroll-x(g: int) -> length {
        return g == 0 ? g0.scroll-x : g1.scroll-x;
    }
    public pure function editor-scroll-y(g: int) -> length {
        return g == 0 ? g0.scroll-y : g1.scroll-y;
    }
    public function set-scroll(g: int, x: length, y: length) {
        if g == 0 {
            g0.scroll-x = x;
            g0.scroll-y = y;
        } else {
            g1.scroll-x = x;
            g1.scroll-y = y;
        }
    }
    public pure function editor-visible-height(g: int) -> length {
        return g == 0 ? g0.visible-height : g1.visible-height;
    }
    public pure function editor-focused(g: int) -> bool {
        return g0.editor-focused || g1.editor-focused;
    }
    public function focus-tree() {
        tree-fs.focus();
    }
    public function focus-root() {
        root-fs.focus();
    }
    root-fs := FocusScope {
        focus-on-click: false;
        capture-key-pressed(e) => {
            if root.global-key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt) {
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        VerticalLayout {
            spacing: 0;

            // ================= TITLE BAR =================
            Rectangle {
                height: 35px;
                background: T.bg-side;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: T.border;
                }

                WindowMoveArea {
                    TouchArea {
                        double-clicked => {
                            root.win-toggle-maximize();
                        }
                        clicked => {
                            root.popup-dismiss();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 0;
                        AppLogo {
                            y: (35px - 16px) / 2;
                        }

                        Rectangle {
                            width: 6px;
                        }

                        menubar := HorizontalLayout {
                            alignment: start;
                            padding-top: 4px;
                            padding-bottom: 5px;
                            for title[i] in root.menu-titles: MenuTitle {
                                label: title;
                                open: root.menu-index == i;
                                pressed => {
                                    if root.menu-index == i {
                                        root.popup-dismiss();
                                    } else {
                                        root.menu-open(i, self.absolute-position.x);
                                    }
                                }
                                hovered => {
                                    if root.menu-index >= 0 && root.menu-index != i {
                                        root.menu-open(i, self.absolute-position.x);
                                    }
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Rectangle {
                            width: 46px * 3;
                        }
                    }

                    // command center (centered in window)
                    cc := Rectangle {
                        width: min(600px, root.width * 0.38);
                        height: 24px;
                        x: (root.width - self.width) / 2;
                        y: (35px - self.height) / 2;
                        border-radius: 6px;
                        background: cc-ta.has-hover ? #ffffff17 : #ffffff0d;
                        border-width: 1px;
                        border-color: #ffffff1a;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Icon {
                                y: (24px - 14px) / 2;
                                d: Icons.search;
                                size: 14px;
                                color: T.fg;
                            }

                            Text {
                                text: root.command-center-text;
                                color: T.fg;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        cc-ta := TouchArea {
                            clicked => {
                                root.command-center-clicked();
                            }
                        }
                    }
                }

                // CPU / memory of this process
                Rectangle {
                    x: parent.width - 46px * 3 - self.width - 8px;
                    y: (35px - self.height) / 2;
                    height: 24px;
                    width: stl.preferred-width + 16px;
                    border-radius: 5px;
                    background: root.stats-open || sta2.has-hover ? T.toolbar-hover : transparent;
                    stl := Text {
                        text: root.stats-label;
                        color: T.fg-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    sta2 := TouchArea {
                        clicked => {
                            root.stats-clicked();
                        }
                    }
                }

                // window controls
                HorizontalLayout {
                    x: parent.width - 46px * 3;
                    width: 46px * 3;
                    height: 34px;
                    WinButton {
                        icon: Icons.win-min;
                        clicked => {
                            root.win-minimize();
                        }
                    }

                    WinButton {
                        icon: root.maximized ? Icons.win-restore : Icons.win-max;
                        clicked => {
                            root.win-toggle-maximize();
                        }
                    }

                    WinButton {
                        icon: Icons.close;
                        danger: true;
                        clicked => {
                            root.win-close();
                        }
                    }
                }
            }

            // ================= MAIN =================
            HorizontalLayout {
                spacing: 0;
                vertical-stretch: 1;

                // ---------- activity bar ----------
                Rectangle {
                    width: 48px;
                    background: T.bg-side;
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: T.border;
                    }

                    VerticalLayout {
                        alignment: start;
                        ActivityItem {
                            icon: Icons.files;
                            active: root.sidebar-visible && root.active-view == "explorer";
                            clicked => {
                                root.activity("explorer");
                            }
                        }

                        ActivityItem {
                            icon: Icons.search;
                            active: root.sidebar-visible && root.active-view == "search";
                            clicked => {
                                root.activity("search");
                            }
                        }

                        ActivityItem {
                            icon: Icons.scm;
                            active: root.sidebar-visible && root.active-view == "scm";
                            clicked => {
                                root.activity("scm");
                            }
                        }

                        ActivityItem {
                            icon: Icons.run;
                            active: root.sidebar-visible && root.active-view == "run";
                            clicked => {
                                root.activity("run");
                            }
                        }

                        ActivityItem {
                            icon: Icons.extensions;
                            active: root.sidebar-visible && root.active-view == "extensions";
                            clicked => {
                                root.activity("extensions");
                            }
                        }

                        ActivityItem {
                            icon: Icons.remote;
                            active: root.sidebar-visible && root.active-view == "remote";
                            clicked => {
                                root.activity("remote");
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: end;
                        ActivityItem {
                            icon: Icons.account;
                            clicked => {
                                root.activity("account");
                            }
                        }

                        ActivityItem {
                            icon: Icons.gear;
                            clicked => {
                                root.activity("manage");
                            }
                        }
                    }
                }

                // ---------- side bar ----------
                if root.sidebar-visible: Rectangle {
                    width: root.sidebar-width;
                    background: T.bg-side;
                    side-ta := TouchArea { }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: T.border;
                    }

                    VerticalLayout {
                        // view title
                        Rectangle {
                            height: 35px;
                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 8px;
                                Text {
                                    text: root.active-view == "explorer" ? "EXPLORER" : root.active-view == "search" ? "SEARCH" : root.active-view == "scm" ? "SOURCE CONTROL" : root.active-view == "run" ? "RUN AND DEBUG" : root.active-view == "extensions" ? "EXTENSIONS" : "REMOTE EXPLORER";
                                    font-size: 11px;
                                    color: T.fg;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                if root.active-view == "search": HorizontalLayout {
                                    spacing: 0;
                                    ToolButton {
                                        y: (35px - 22px) / 2;
                                        icon: Icons.refresh;
                                        clicked => {
                                            root.search-action("refresh");
                                        }
                                    }

                                    ToolButton {
                                        y: (35px - 22px) / 2;
                                        icon: "M5 6 H19 M8 6 V4 H16 V6 M7 6 L8 20 H16 L17 6";
                                        clicked => {
                                            root.search-action("clear");
                                        }
                                    }

                                    ToolButton {
                                        y: (35px - 22px) / 2;
                                        icon: Icons.collapse;
                                        clicked => {
                                            root.search-action("collapse");
                                        }
                                    }
                                }
                                if root.active-view != "search": Text {
                                    text: "···";
                                    color: T.fg;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // ---- explorer ----
                        if root.active-view == "explorer": VerticalLayout {
                            vertical-stretch: 1;
                            // section header
                            sec := Rectangle {
                                height: 22px;
                                sec-ta := TouchArea { }

                                HorizontalLayout {
                                    padding-left: 2px;
                                    padding-right: 8px;
                                    spacing: 2px;
                                    Icon {
                                        y: 3px;
                                        d: Icons.chevron-down;
                                        size: 16px;
                                        color: T.fg;
                                    }

                                    Text {
                                        text: root.workspace-name == "" ? "NO FOLDER OPENED" : root.workspace-name;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: T.fg;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    if root.workspace-name != "" && (side-ta.has-hover || root.tree-focused): HorizontalLayout {
                                        spacing: 0;
                                        ToolButton {
                                            icon: Icons.new-file;
                                            clicked => {
                                                root.explorer-action("new-file");
                                            }
                                        }

                                        ToolButton {
                                            icon: Icons.new-folder;
                                            clicked => {
                                                root.explorer-action("new-folder");
                                            }
                                        }

                                        ToolButton {
                                            icon: Icons.refresh;
                                            clicked => {
                                                root.explorer-action("refresh");
                                            }
                                        }

                                        ToolButton {
                                            icon: Icons.collapse;
                                            clicked => {
                                                root.explorer-action("collapse");
                                            }
                                        }
                                    }
                                }
                            }

                            if root.workspace-name == "": VerticalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                padding-top: 10px;
                                spacing: 14px;
                                alignment: start;
                                Text {
                                    text: "You have not yet opened a folder.";
                                    color: T.fg;
                                    wrap: word-wrap;
                                }

                                BlueButton {
                                    text: "Open Folder";
                                    clicked => {
                                        root.explorer-action("open-folder");
                                    }
                                }

                                Text {
                                    text: "Connect to a remote machine over SSH and edit its files in place.";
                                    color: T.fg;
                                    wrap: word-wrap;
                                }

                                BlueButton {
                                    text: "Connect to Host...";
                                    clicked => {
                                        root.explorer-action("open-remote");
                                    }
                                }
                            }

                            if root.workspace-name != "": tree-wrap := Rectangle {
                                vertical-stretch: 1;
                                tree-ta := TouchArea {
                                    pointer-event(e) => {
                                        if e.kind == PointerEventKind.down {
                                            tree-fs.focus();
                                            if e.button == PointerEventButton.right {
                                                root.tree-context(-1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                    }
                                }

                                ListView {
                                    for row[i] in root.tree-rows: TreeRowView {
                                        data: row;
                                        focused: root.tree-focused;
                                        clicked => {
                                            tree-fs.focus();
                                            root.tree-clicked(i);
                                        }
                                        context(x, y) => {
                                            tree-fs.focus();
                                            root.tree-context(i, x, y);
                                        }
                                    }
                                }
                            }
                        }

                        // ---- remote explorer ----
                        if root.active-view == "remote": VerticalLayout {
                            vertical-stretch: 1;
                            Rectangle {
                                height: 22px;
                                rsec-ta := TouchArea { }

                                HorizontalLayout {
                                    padding-left: 2px;
                                    padding-right: 8px;
                                    spacing: 2px;
                                    Icon {
                                        y: 3px;
                                        d: Icons.chevron-down;
                                        size: 16px;
                                        color: T.fg;
                                    }

                                    Text {
                                        text: "SSH";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: T.fg;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    ToolButton {
                                        icon: Icons.gear;
                                        clicked => {
                                            root.remote-action("config");
                                        }
                                    }

                                    ToolButton {
                                        icon: Icons.refresh;
                                        clicked => {
                                            root.remote-action("refresh");
                                        }
                                    }
                                }
                            }

                            if root.hosts.length == 0: Text {
                                text: "No hosts found in ~/.ssh/config.";
                                color: T.fg-dim;
                                x: 20px;
                                wrap: word-wrap;
                            }
                            ListView {
                                for h[i] in root.hosts: Rectangle {
                                    height: 22px;
                                    background: hta.has-hover ? T.hover : transparent;
                                    HorizontalLayout {
                                        padding-left: 22px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        Icon {
                                            y: 3px;
                                            d: Icons.remote;
                                            size: 16px;
                                            color: h.connected ? #73c991 : T.fg;
                                        }

                                        Text {
                                            text: h.name;
                                            color: T.fg;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: h.detail;
                                            color: T.fg-muted;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }

                                        if hta.has-hover: Icon {
                                            y: 3px;
                                            d: Icons.arrow-right;
                                            size: 16px;
                                            color: T.fg;
                                        }
                                    }

                                    hta := TouchArea {
                                        clicked => {
                                            root.host-clicked(i);
                                        }
                                    }
                                }
                            }
                        }

                        // ---- search ----
                        if root.active-view == "search": VerticalLayout {
                            vertical-stretch: 1;
                            padding-left: 12px;
                            padding-right: 10px;
                            spacing: 8px;
                            Rectangle {
                                height: 26px;
                                background: T.input-bg;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: si.has-focus ? T.focus-border : T.input-border;
                                si := TextInput {
                                    x: 6px;
                                    width: parent.width - 80px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    single-line: true;
                                    text <=> root.search-text;
                                    color: T.fg;
                                    selection-background-color: T.selection;
                                    init => {
                                        self.focus();
                                        self.select-all();
                                    }
                                    property <int> req: root.search-focus-req;
                                    changed req => {
                                        self.focus();
                                        self.select-all();
                                    }
                                    edited => {
                                        root.search-edited(self.text);
                                    }
                                    key-pressed(e) => {
                                        if e.text == Key.Return {
                                            root.search-submit();
                                            return EventResult.accept;
                                        }
                                        return EventResult.reject;
                                    }
                                }

                                if root.search-text == "": Text {
                                    x: 6px;
                                    text: "Search";
                                    color: T.fg-muted;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    x: parent.width - 72px;
                                    width: 70px;
                                    y: 3px;
                                    height: 20px;
                                    spacing: 2px;
                                    ToolButton {
                                        width: 20px;
                                        height: 20px;
                                        icon: "M3 17 L7 7 L11 17 M4.5 13.5 H9.5 M13 12 a3 3 0 1 0 6 0 a3 3 0 1 0 -6 0 Z M19 9 V17";
                                        toggled: root.search-case;
                                        clicked => {
                                            root.search-toggle("case");
                                        }
                                    }

                                    ToolButton {
                                        width: 20px;
                                        height: 20px;
                                        icon: "M3 18 H21 M3 15 V18 M21 15 V18 M5 12 a2.5 2.5 0 1 0 5 0 a2.5 2.5 0 1 0 -5 0 Z M13 7 V14.5 M13 12 a2.5 2.5 0 1 0 5 0 a2.5 2.5 0 1 0 -5 0 Z";
                                        toggled: root.search-word;
                                        clicked => {
                                            root.search-toggle("word");
                                        }
                                    }

                                    ToolButton {
                                        width: 20px;
                                        height: 20px;
                                        icon: "M4 18 a1.5 1.5 0 1 0 3 0 a1.5 1.5 0 1 0 -3 0 Z M16 4 V14 M11.7 6.5 L20.3 11.5 M11.7 11.5 L20.3 6.5";
                                        toggled: root.search-regex;
                                        clicked => {
                                            root.search-toggle("regex");
                                        }
                                    }
                                }
                            }

                            if root.search-message != "": Text {
                                text: root.search-message;
                                color: T.fg-dim;
                                wrap: word-wrap;
                            }
                            ListView {
                                vertical-stretch: 1;
                                for r[i] in root.search-rows: Rectangle {
                                    height: 22px;
                                    background: sta.has-hover ? T.hover : transparent;
                                    if r.is-file: HorizontalLayout {
                                        padding-left: 0px;
                                        padding-right: 6px;
                                        spacing: 4px;
                                        Icon {
                                            y: 3px;
                                            d: r.expanded ? Icons.chevron-down : Icons.chevron-right;
                                            size: 16px;
                                            color: T.fg;
                                        }

                                        Text {
                                            text: r.glyph;
                                            color: r.glyph-color;
                                            font-size: 10px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: r.name;
                                            color: T.fg;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: r.dir;
                                            color: T.fg-muted;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }

                                        Rectangle {
                                            y: 3px;
                                            height: 16px;
                                            width: max(16px, bt.preferred-width + 10px);
                                            border-radius: 8px;
                                            background: #616161;
                                            bt := Text {
                                                text: r.count;
                                                color: #ffffff;
                                                font-size: 11px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    if !r.is-file: HorizontalLayout {
                                        padding-left: 38px;
                                        padding-right: 6px;
                                        spacing: 0;
                                        Text {
                                            text: r.before;
                                            color: T.fg;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            width: ht.preferred-width;
                                            background: #ea5c0055;
                                            ht := Text {
                                                text: r.hit;
                                                color: T.fg;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: r.after;
                                            color: T.fg;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    sta := TouchArea {
                                        clicked => {
                                            root.search-row-clicked(i);
                                        }
                                    }
                                }
                            }
                        }

                        // ---- extensions ----
                        if root.active-view == "extensions": VerticalLayout {
                            vertical-stretch: 1;
                            ListView {
                                for x[i] in root.ext-rows: Rectangle {
                                    height: xl.preferred-height;
                                    background: xta.has-hover ? T.hover : transparent;
                                    xta := TouchArea {
                                        clicked => {
                                            root.ext-toggle(i);
                                        }
                                    }

                                    xl := VerticalLayout {
                                        // section headers
                                        if i == 0 || (x.kind == 1 && root.ext-rows[i - 1].kind == 0): Rectangle {
                                            height: 26px;
                                            Text {
                                                x: 12px;
                                                text: x.kind == 0 ? "INSTALLED" : "LANGUAGES";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: T.fg;
                                                vertical-alignment: center;
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            padding-top: 6px;
                                            padding-bottom: 6px;
                                            spacing: 10px;
                                            Rectangle {
                                                width: 36px;
                                                height: 36px;
                                                border-radius: 4px;
                                                background: x.kind == 0 ? #0e639c : #3a3d41;
                                                Text {
                                                    text: x.kind == 0 ? "EXT" : "{ }";
                                                    color: #ffffff;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 2px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text {
                                                        text: x.name;
                                                        color: T.fg-bright;
                                                        font-weight: 600;
                                                        overflow: elide;
                                                    }

                                                    Text {
                                                        text: x.detail;
                                                        color: T.fg-muted;
                                                        font-size: 12px;
                                                        overflow: elide;
                                                        horizontal-stretch: 1;
                                                    }
                                                }

                                                Text {
                                                    text: x.error != "" ? x.error : x.description;
                                                    color: x.error != "" ? T.error : T.fg-dim;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            CheckBox {
                                                y: 9px;
                                                checked: x.enabled;
                                                toggled => {
                                                    root.ext-toggle(i);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.ext-rows.length == 0: Text {
                                x: 20px;
                                width: parent.width - 40px;
                                text: "No extensions found. Put extension folders in " + root.ext-dir;
                                color: T.fg-dim;
                                wrap: word-wrap;
                            }
                        }

                        // ---- not yet implemented views ----
                        if root.active-view != "explorer" && root.active-view != "remote" && root.active-view != "search" && root.active-view != "extensions": VerticalLayout {
                            padding: 20px;
                            alignment: start;
                            Text {
                                text: "This view is not available yet.";
                                color: T.fg-dim;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ---------- editor groups ----------
                groups := Rectangle {
                    horizontal-stretch: 1;
                    background: T.bg-editor;
                    property <length> w0: root.split ? max(120px, min(self.width - 120px, self.width * root.split-ratio)) : self.width;
                    g0 := EditorGroup {
                        x: 0;
                        width: parent.w0;
                        data: root.group0;
                        editor-font-size: root.editor-font-size;
                        find-open: root.find-open;
                        replace-open: root.replace-open;
                        find-text <=> root.find-text;
                        replace-text <=> root.replace-text;
                        find-info: root.find-info;
                        find-case: root.find-case;
                        find-word: root.find-word;
                        activated => {
                            root.group-activated(0);
                        }
                        tab-clicked(i) => {
                            root.tab-clicked(0, i);
                        }
                        tab-close(i) => {
                            root.tab-close(0, i);
                        }
                        title-button => {
                            root.title-button-clicked(0);
                        }
                        command(c) => {
                            root.command(c);
                        }
                        editor-edited(t) => {
                            root.editor-edited(0, t);
                        }
                        editor-key(t, c, s, a) => {
                            return root.editor-key(0, t, c, s, a);
                        }
                        editor-cursor-moved(c, a) => {
                            root.editor-cursor-moved(0, c, a);
                        }
                        gutter-clicked(l, s) => {
                            root.gutter-clicked(0, l, s);
                        }
                        editor-viewport(f, r) => {
                            root.editor-viewport(0, f, r);
                        }
                        panel-link(u) => {
                            root.panel-link(0, u);
                        }
                        panel-button(b) => {
                            root.panel-button(0, b);
                        }
                        find-edited(t) => {
                            root.find-edited(t);
                        }
                        find-next(b) => {
                            root.find-next(b);
                        }
                        replace-one => {
                            root.replace-one();
                        }
                        replace-all => {
                            root.replace-all();
                        }
                        find-close => {
                            root.find-close();
                        }
                        find-toggle-replace => {
                            root.find-toggle-replace();
                        }
                        find-toggle(w) => {
                            root.find-toggle(w);
                        }
                    }

                    g1 := EditorGroup {
                        x: parent.w0;
                        width: root.split ? parent.width - parent.w0 : 0px;
                        visible: root.split;
                        data: root.group1;
                        editor-font-size: root.editor-font-size;
                        find-open: root.find-open;
                        replace-open: root.replace-open;
                        find-text <=> root.find-text;
                        replace-text <=> root.replace-text;
                        find-info: root.find-info;
                        find-case: root.find-case;
                        find-word: root.find-word;
                        activated => {
                            root.group-activated(1);
                        }
                        tab-clicked(i) => {
                            root.tab-clicked(1, i);
                        }
                        tab-close(i) => {
                            root.tab-close(1, i);
                        }
                        title-button => {
                            root.title-button-clicked(1);
                        }
                        command(c) => {
                            root.command(c);
                        }
                        editor-edited(t) => {
                            root.editor-edited(1, t);
                        }
                        editor-key(t, c, s, a) => {
                            return root.editor-key(1, t, c, s, a);
                        }
                        editor-cursor-moved(c, a) => {
                            root.editor-cursor-moved(1, c, a);
                        }
                        gutter-clicked(l, s) => {
                            root.gutter-clicked(1, l, s);
                        }
                        editor-viewport(f, r) => {
                            root.editor-viewport(1, f, r);
                        }
                        panel-link(u) => {
                            root.panel-link(1, u);
                        }
                        panel-button(b) => {
                            root.panel-button(1, b);
                        }
                        find-edited(t) => {
                            root.find-edited(t);
                        }
                        find-next(b) => {
                            root.find-next(b);
                        }
                        replace-one => {
                            root.replace-one();
                        }
                        replace-all => {
                            root.replace-all();
                        }
                        find-close => {
                            root.find-close();
                        }
                        find-toggle-replace => {
                            root.find-toggle-replace();
                        }
                        find-toggle(w) => {
                            root.find-toggle(w);
                        }
                    }

                    // border and sash between the groups
                    if root.split: Rectangle {
                        x: parent.w0;
                        width: 1px;
                        background: T.border;
                    }
                    if root.split: TouchArea {
                        x: parent.w0 - 2px;
                        width: 5px;
                        mouse-cursor: ew-resize;
                        moved => {
                            if self.pressed {
                                root.split-ratio = clamp((parent.w0 + self.mouse-x - self.pressed-x) / parent.width, 0.15, 0.85);
                            }
                        }
                        Rectangle {
                            background: parent.pressed || parent.has-hover ? T.accent : transparent;
                        }
                    }
                }
            }

            // ================= STATUS BAR =================
            Rectangle {
                height: 22px;
                background: T.bg-side;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: T.border;
                }

                HorizontalLayout {
                    spacing: 0;
                    StatusItem {
                        icon: Icons.remote-indicator;
                        text: root.status-remote-busy ? "Opening Remote..." : root.status-remote;
                        fg: #ffffff;
                        bg: T.accent;
                        hover-bg: T.accent-hover;
                        clicked => {
                            root.status-clicked("remote");
                        }
                    }

                    StatusItem {
                        icon: Icons.error;
                        text: "0";
                    }

                    StatusItem {
                        icon: Icons.warning;
                        text: "0";
                    }

                    if root.status-message != "": Text {
                        text: root.status-message;
                        color: T.fg;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    if root.editor-visible: StatusItem {
                        text: root.status-lncol;
                        clicked => {
                            root.status-clicked("lncol");
                        }
                    }
                    if root.editor-visible: StatusItem {
                        text: root.status-indent;
                        clicked => {
                            root.status-clicked("indent");
                        }
                    }
                    if root.editor-visible: StatusItem {
                        text: root.status-encoding;
                    }
                    if root.editor-visible: StatusItem {
                        text: root.status-eol;
                        clicked => {
                            root.status-clicked("eol");
                        }
                    }
                    if root.editor-visible: StatusItem {
                        text: root.status-lang;
                        clicked => {
                            root.status-clicked("lang");
                        }
                    }
                    StatusItem {
                        icon: Icons.bell;
                    }

                    Rectangle {
                        width: 6px;
                    }
                }
            }
        }

        // ================= SASH (sidebar resize) =================
        if root.sidebar-visible: sash := TouchArea {
            x: 48px + root.sidebar-width - 2px;
            y: 35px;
            width: 4px;
            height: root.height - 35px - 22px;
            mouse-cursor: ew-resize;
            moved => {
                if self.pressed {
                    root.sidebar-width = clamp(root.sidebar-width + self.mouse-x - self.pressed-x, 170px, root.width - 360px);
                }
            }
            Rectangle {
                background: parent.pressed || parent.has-hover ? T.accent : transparent;
            }
        }

        // ================= NOTIFICATIONS =================
        VerticalLayout {
            x: root.width - self.width - 12px;
            y: root.height - 22px - 12px - self.preferred-height;
            width: 450px;
            height: self.preferred-height;
            spacing: 6px;
            for t[i] in root.toasts: Rectangle {
                height: max(42px, tl.preferred-height + 20px);
                background: T.widget-bg;
                border-radius: 4px;
                border-width: 1px;
                border-color: #303031;
                drop-shadow-blur: 10px;
                drop-shadow-color: T.shadow;
                tl := HorizontalLayout {
                    padding: 10px;
                    padding-left: 12px;
                    spacing: 10px;
                    Icon {
                        d: t.kind == 2 ? Icons.error : t.kind == 1 ? Icons.warning : Icons.info;
                        size: 16px;
                        color: t.kind == 2 ? T.error : t.kind == 1 ? T.warning : T.info;
                    }

                    Text {
                        text: t.message;
                        color: T.fg;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    ToolButton {
                        icon: Icons.close;
                        clicked => {
                            root.toast-close(i);
                        }
                    }
                }
            }
        }

        // ================= CPU / MEMORY GRAPH =================
        if root.stats-open: Rectangle {
            x: 0;
            y: 35px;
            width: root.width;
            height: root.height - 35px;
            TouchArea {
                clicked => {
                    root.stats-clicked();
                }
            }

            Rectangle {
                x: parent.width - 46px * 3 - self.width;
                y: 4px;
                width: 280px;
                height: sl.preferred-height;
                background: T.widget-bg;
                border-radius: 6px;
                border-width: 1px;
                border-color: T.menu-border;
                drop-shadow-blur: 10px;
                drop-shadow-color: T.shadow;
                TouchArea { }

                sl := VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    Text {
                        text: "rcode process (last 2 minutes)";
                        color: T.fg;
                        font-weight: 600;
                    }

                    for g in [
                        { title: "CPU", max: root.stats-cpu-max, path: root.stats-cpu-path, color: #3794ff },
                        { title: "Memory", max: root.stats-mem-max, path: root.stats-mem-path, color: #73c991 },
                    ]: VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            Text {
                                text: g.title;
                                color: T.fg-dim;
                                font-size: 12px;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: g.max;
                                color: T.fg-muted;
                                font-size: 11px;
                            }
                        }

                        Rectangle {
                            height: 48px;
                            background: #ffffff08;
                            border-radius: 3px;
                            if g.path != "": Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-width: 100;
                                viewbox-height: 30;
                                commands: g.path;
                                stroke: g.color;
                                stroke-width: 1.5px;
                                fill: transparent;
                            }
                        }
                    }
                }
            }
        }

        // ================= POPUP MENU =================
        if root.popup-open: pop := Rectangle {
            x: 0;
            y: root.popup-from-menubar ? 35px : 0;
            width: root.width;
            height: root.height - self.y;
            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.popup-dismiss();
                    }
                }
            }

            property <int> sel: -1;
            menu-box := Rectangle {
                x: min(root.popup-x, root.width - self.width - 4px);
                y: min(root.popup-y - parent.y, parent.height - self.height - 4px);
                width: max(300px, ml.preferred-width);
                height: ml.preferred-height;
                background: T.menu-bg;
                border-radius: 5px;
                border-width: 1px;
                border-color: T.menu-border;
                drop-shadow-blur: 8px;
                drop-shadow-color: T.shadow;
                TouchArea { }

                pfs := FocusScope {
                    init => {
                        self.focus();
                    }
                    key-pressed(e) => {
                        if e.text == Key.Escape {
                            root.popup-dismiss();
                            return EventResult.accept;
                        }
                        if e.text == Key.DownArrow {
                            pop.sel = Math.mod(pop.sel + 1, root.popup-items.length);
                            return EventResult.accept;
                        }
                        if e.text == Key.UpArrow {
                            pop.sel = pop.sel <= 0 ? root.popup-items.length - 1 : pop.sel - 1;
                            return EventResult.accept;
                        }
                        if e.text == Key.Return && pop.sel >= 0 {
                            root.popup-activated(pop.sel);
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }
                }

                ml := VerticalLayout {
                    padding-top: 4px;
                    padding-bottom: 4px;
                    for it[i] in root.popup-items: Rectangle {
                        height: it.separator ? 9px : 26px;
                        if it.separator: Rectangle {
                            x: 10px;
                            width: parent.width - 20px;
                            height: 1px;
                            background: T.menu-border;
                        }
                        if !it.separator: Rectangle {
                            x: 4px;
                            width: parent.width - 8px;
                            border-radius: 3px;
                            background: it.enabled && (ita.has-hover || pop.sel == i) ? T.menu-sel : transparent;
                            HorizontalLayout {
                                padding-left: 22px;
                                padding-right: 18px;
                                spacing: 30px;
                                Text {
                                    text: it.label;
                                    color: it.enabled ? (ita.has-hover || pop.sel == i ? #ffffff : T.fg) : #ffffff55;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: it.keybinding;
                                    color: it.enabled ? (ita.has-hover || pop.sel == i ? #ffffff : T.fg) : #ffffff55;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }

                            ita := TouchArea {
                                enabled: it.enabled;
                                clicked => {
                                    root.popup-activated(i);
                                }
                            }
                        }
                    }
                }
            }
        }

        // ================= QUICK INPUT =================
        if root.quick-open: Rectangle {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.quick-cancel();
                    }
                }
            }

            qbox := Rectangle {
                width: min(600px, root.width - 40px);
                x: (root.width - self.width) / 2;
                y: 6px;
                height: ql.preferred-height;
                background: T.quick-bg;
                border-radius: 6px;
                border-width: 1px;
                border-color: T.widget-border;
                drop-shadow-blur: 10px;
                drop-shadow-color: T.shadow;
                drop-shadow-offset-y: 2px;
                TouchArea { }

                ql := VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    if root.quick-title != "": Text {
                        text: root.quick-title;
                        color: T.fg;
                        horizontal-alignment: center;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        background: T.input-bg;
                        border-radius: 2px;
                        border-width: 1px;
                        border-color: qi.has-focus ? T.focus-border : T.input-border;
                        qi := TextInput {
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            vertical-alignment: center;
                            single-line: true;
                            input-type: root.quick-password ? InputType.password : InputType.text;
                            text <=> root.quick-text;
                            color: T.fg;
                            selection-background-color: T.selection;
                            init => {
                                self.focus();
                                if root.quick-cursor-pos >= 0 {
                                    self.set-selection-offsets(root.quick-cursor-pos, root.quick-cursor-pos);
                                } else {
                                    self.select-all();
                                }
                            }
                            property <int> reset: root.quick-reset-cursor;
                            changed reset => {
                                self.set-selection-offsets(root.quick-cursor-pos, root.quick-cursor-pos);
                            }
                            edited => {
                                root.quick-index = 0;
                                ql-view.content-y = 0;
                                root.quick-edited(self.text);
                            }
                            key-pressed(e) => {
                                if e.text == Key.Escape {
                                    root.quick-cancel();
                                    return EventResult.accept;
                                }
                                if e.text == Key.Return {
                                    root.quick-accept(root.quick-index);
                                    return EventResult.accept;
                                }
                                if e.text == Key.DownArrow && root.quick-items.length > 0 {
                                    root.quick-index = Math.mod(root.quick-index + 1, root.quick-items.length);
                                    ql-view.keep-visible();
                                    return EventResult.accept;
                                }
                                if e.text == Key.UpArrow && root.quick-items.length > 0 {
                                    root.quick-index = root.quick-index <= 0 ? root.quick-items.length - 1 : root.quick-index - 1;
                                    ql-view.keep-visible();
                                    return EventResult.accept;
                                }
                                if e.text == Key.PageDown && root.quick-items.length > 0 {
                                    root.quick-index = min(root.quick-items.length - 1, root.quick-index + 10);
                                    ql-view.keep-visible();
                                    return EventResult.accept;
                                }
                                if e.text == Key.PageUp && root.quick-items.length > 0 {
                                    root.quick-index = max(0, root.quick-index - 10);
                                    ql-view.keep-visible();
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                        }

                        if root.quick-text == "": Text {
                            x: 6px;
                            text: root.quick-placeholder;
                            color: T.fg-muted;
                            vertical-alignment: center;
                        }
                    }

                    if root.quick-ok: BlueButton {
                        text: "OK";
                        clicked => {
                            root.quick-accept(-1);
                        }
                    }
                    }

                    ql-view := ListView {
                        visible: root.quick-items.length > 0;
                        height: min(root.quick-items.length, 15) * 22px;
                        public function keep-visible() {
                            if root.quick-index * 22px + self.content-y < 0 {
                                self.content-y = -root.quick-index * 22px;
                            } else if (root.quick-index + 1) * 22px + self.content-y > self.visible-height {
                                self.content-y = self.visible-height - (root.quick-index + 1) * 22px;
                            }
                        }
                        for q[i] in root.quick-items: Rectangle {
                            height: 22px;
                            border-radius: 3px;
                            background: q.selectable && i == root.quick-index ? T.list-active : qa.has-hover && q.selectable ? T.hover : transparent;
                            HorizontalLayout {
                                padding-left: 11px;
                                padding-right: 11px;
                                spacing: 6px;
                                if q.glyph != "": Text {
                                    width: 18px;
                                    text: q.glyph;
                                    color: q.glyph-color;
                                    font-size: 10px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: q.label;
                                    color: q.selectable ? T.fg-bright : T.fg;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Text {
                                    text: q.desc;
                                    color: T.fg-muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                if q.keybinding != "": Text {
                                    text: q.keybinding;
                                    color: T.fg-dim;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            qa := TouchArea {
                                enabled: q.selectable;
                                clicked => {
                                    root.quick-index = i;
                                    root.quick-accept(i);
                                }
                            }
                        }
                    }
                }
            }
        }

        // ================= MODAL DIALOG =================
        if root.dialog-open: Rectangle {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            background: #00000066;
            TouchArea { }

            Rectangle {
                width: 460px;
                height: dl.preferred-height;
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 3;
                background: T.widget-bg;
                border-radius: 6px;
                border-width: 1px;
                border-color: T.menu-border;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000099;
                dfs := FocusScope {
                    init => {
                        self.focus();
                    }
                    key-pressed(e) => {
                        if e.text == Key.Escape {
                            root.dialog-result(-1);
                            return EventResult.accept;
                        }
                        if e.text == Key.Return {
                            root.dialog-result(0);
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }
                }

                dl := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 14px;
                        Icon {
                            d: Icons.warning;
                            size: 32px;
                            stroke-w: 1.5px;
                            color: T.warning;
                        }

                        VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: root.dialog-message;
                                color: T.fg-bright;
                                font-weight: 600;
                                wrap: word-wrap;
                            }

                            if root.dialog-detail != "": Text {
                                text: root.dialog-detail;
                                color: T.fg;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        for b[i] in root.dialog-buttons: BlueButton {
                            text: b;
                            secondary: i > 0;
                            clicked => {
                                root.dialog-result(i);
                            }
                        }
                    }
                }
            }
        }

        // ================= WINDOW EDGES (resize a frameless window) =================
        if !root.maximized: Rectangle {
            property <length> e: 5px;
            for z in [
                { d: 0, x: 8px, y: 0px, w: root.width - 16px, h: 4px, c: MouseCursor.ns-resize },
                { d: 4, x: 8px, y: root.height - 4px, w: root.width - 16px, h: 4px, c: MouseCursor.ns-resize },
                { d: 6, x: 0px, y: 8px, w: 4px, h: root.height - 16px, c: MouseCursor.ew-resize },
                { d: 2, x: root.width - 4px, y: 8px, w: 4px, h: root.height - 16px, c: MouseCursor.ew-resize },
                { d: 7, x: 0px, y: 0px, w: 8px, h: 8px, c: MouseCursor.nwse-resize },
                { d: 3, x: root.width - 8px, y: root.height - 8px, w: 8px, h: 8px, c: MouseCursor.nwse-resize },
                { d: 1, x: root.width - 8px, y: 0px, w: 8px, h: 8px, c: MouseCursor.nesw-resize },
                { d: 5, x: 0px, y: root.height - 8px, w: 8px, h: 8px, c: MouseCursor.nesw-resize },
            ]: TouchArea {
                x: z.x;
                y: z.y;
                width: z.w;
                height: z.h;
                mouse-cursor: z.c;
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                        root.start-resize(z.d);
                    }
                }
            }
        }

        // keyboard focus target for the explorer tree (invisible, keeps focus when a row is clicked)
        tree-fs := FocusScope {
            x: 0;
            y: 0;
            width: 0;
            height: 0;
            focus-on-click: false;
            key-pressed(e) => {
                if root.tree-key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt) {
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
        }
    }
}
